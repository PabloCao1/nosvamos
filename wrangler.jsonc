{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
